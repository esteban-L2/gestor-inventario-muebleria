# Copia este archivo como .env y ajusta los valores. El .env NO se sube a GitHub.

# Conexión a PostgreSQL local: usuario:contraseña@host:puerto/base
DATABASE_URL=postgresql+psycopg://postgres:TU_CONTRASEÑA@localhost:5432/inventario_muebleria

# Secreto para firmar los tokens de sesión (genera uno largo y aleatorio)
JWT_SECRET=cambia-esto

# Origen del frontend permitido (CORS)
FRONTEND_URL=http://localhost:5173
